#!/bin/bash

LIB_DIR=@CMAKE_INSTALL_FULL_LIBDIR@
BIN_DIR=@CMAKE_INSTALL_FULL_BINDIR@
TEST_DIR=@CMAKE_CURRENT_BINARY_DIR@
SCRATCH=@CMAKE_TEST_SCRATCH@
PERSISTENT=@CMAKE_TEST_PERSISTENT@
META=@CMAKE_TEST_META@

export LD_LIBRARY_PATH=$LIB_DIR:$LD_LIBRARY_PATH
export VELOC_BIN=$BIN_DIR
clean() { rm -rf $SCRATCH $PERSISTENT $META; mkdir -p $SCRATCH $PERSISTENT $META; }

CFG=$TEST_DIR/gpu-sync.cfg
NP=${NP:-2}
ARRAY_MIB=${ARRAY_MIB:-256}
# same random seed for both runs: the restart run regenerates the pattern to verify
SEED=${SEED:-$(od -An -N4 -tu4 /dev/urandom | tr -d " ")}
echo "pattern seed: $SEED"

clean
# first run does only checkpoint, second run does only restart + verify
echo "running test_gpu_mpi ($NP ranks) for checkpoint"
mpirun $MPI_OPT -np $NP $TEST_DIR/test_gpu_mpi $CFG $ARRAY_MIB $SEED || { echo "test_gpu_mpi: checkpoint run FAILED"; exit 1; }

echo "recovering from checkpoint"
mpirun $MPI_OPT -np $NP $TEST_DIR/test_gpu_mpi $CFG $ARRAY_MIB $SEED
EXIT_CODE=$?

rm -rf $SCRATCH $PERSISTENT $META
[ $EXIT_CODE -eq 0 ] && echo "test_gpu_mpi: PASSED" || echo "test_gpu_mpi: FAILED"
exit $EXIT_CODE
